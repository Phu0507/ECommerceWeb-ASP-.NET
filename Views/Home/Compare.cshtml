
@{
    ViewData["Title"] = "Product Compare";
    var key = 0;
}
<h3>Product Compare</h3>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var compareItems in Model)
        {
            key++;
            <tr>
                <th scope="row">@key</th>
                <td>@compareItems.Product.Name</td>
                <td>@compareItems.Product.Price.ToString("#,##0 VND")</td>
                <td>@Html.Raw(@compareItems.Product.Description)</td>
                <td><img width="120" src="~/media/products/@compareItems.Product.ImageUrl" alt="@compareItems.Product.Name" /></td>
                <td>
                    <a class="btn btn-danger btn-sm" asp-action="DeleteCompare" asp-controller="Home" asp-route-id="@compareItems.Compare.Id" onclick="return confirm('Are you sure you want to delete?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {

}

