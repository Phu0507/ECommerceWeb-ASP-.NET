@section Scripts {
    <script>
		$(document).ready(function () {
            $('.add-to-cart').click(function (e) {
                e.preventDefault();
                var productId = $(this).data('product_id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { id: productId },
                    success: function (response) {
                        Swal.fire('Product added to cart successfully!');
                        // Optionally, update cart UI here
                    },
                    error: function () {
						Swal.fire('Error adding product to cart.');
                    }
                });
            });
        });
	</script>
	<!--wishlist-->
	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function (e) {
				e.preventDefault();
				var productId = $(this).data('productId');
				$.ajax({
					url: '@Url.Action("AddWishList", "Home")',
					type: 'POST',
					data: { id: productId },
					success: function (response) {
						Swal.fire('Product added wish list successfully!');
						// Optionally, update cart UI here
					},
					error: function () {
						Swal.fire('Error adding product to cart.');
					}
				});
			});
		});
	</script>
	<!--compare-->
	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function (e) {
				e.preventDefault();
				var productId = $(this).data('productId');
				$.ajax({
					url: '@Url.Action("AddCompare", "Home")',
					type: 'POST',
					data: { id: productId },
					success: function (response) {
						Swal.fire('So sánh thành công');
						// Optionally, update cart UI here
					},
					error: function () {
						Swal.fire('Error.');
					}
				});
			});
		});
	</script>
}