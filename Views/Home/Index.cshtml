							@if(item.Quantity>0)
							{
								<button class="btn btn-default add-to-cart" data-product_id="@item.Id"><i class="fa fa-shopping-cart"> Add to cart</i></button>
							}
                            else
                            {
								<button class="btn btn-default add-to-cart" disabled><i class="fa fa-shopping-cart"> Out of stock</i></button>
                            }
						</div>
					</div>
					</a>
				</div>
				<div class="choose">
					@if (User.Identity.IsAuthenticated)
					{
					<ul class="nav nav-pills nav-justified">
						<li><button class="btn btn-danger add-btn-wishlist" data-product-id="@item.Id">Add to wishlist</button></li>
						<li><button class="btn btn-danger add-btn-compare" data-product-id="@item.Id">Add to compare</button></li>
					</ul>
					}
				</div>
			</div>
		</div>
		}
