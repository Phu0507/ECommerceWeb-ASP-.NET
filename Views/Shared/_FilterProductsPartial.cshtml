@{
    var currentUrl = Url.ActionContext.HttpContext.Request.Path;
}
<div class="container">
    <div class="row">

        <!-- SẮP XẾP -->
        <div class="col-md-2">
            <h5>Sắp xếp theo</h5>
            <select class="form-control" id="sort_by">
                <option value="">-- Chọn --</option>
                <option value="@currentUrl?sort_by=price_increase">Giá tăng dần</option>
                <option value="@currentUrl?sort_by=price_decrease">Giá giảm dần</option>
                <option value="@currentUrl?sort_by=price_newest">Mới nhất</option>
                <option value="@currentUrl?sort_by=price_oldest">Cũ nhất</option>
            </select>
        </div>

        <!-- LỌC THEO GIÁ -->
        <div class="col-md-5">
            <h5>Lọc theo giá</h5>

            <form asp-action="Index" asp-controller="Category" method="get">

                <!-- GIỮ CATEGORY -->
                <input type="hidden" name="Slug" value="@ViewBag.Slug" />

                <div class="row">
                    <div class="col-md-5">
                        <input type="number"
                               name="minPrice"
                               class="form-control"
                               placeholder="Giá tối thiểu"
                               value="@ViewBag.MinPrice" />
                    </div>

                    <div class="col-md-5">
                        <input type="number"
                               name="maxPrice"
                               class="form-control"
                               placeholder="Giá tối đa"
                               value="@ViewBag.MaxPrice" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-danger mt-2">
                            Lọc giá
                        </button>
                    </div>
                </div>
                
            </form>
        </div>

    </div>
</div>