@model LoginViewModel
@{
    ViewData["Title"] = "Account Management";
}
<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Login to your account</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="Login" asp-controller="Account">
						<input asp-for="Username" type="text" placeholder="Username" />
						<span asp-validation-for="Username" class="text-danger"></span>
						<input asp-for="Password" type="password" placeholder="Password" />
						<span asp-validation-for="Password" class="text-danger"></span>
						<a asp-action="Create" asp-controller="Account">Register</a>
						<a asp-action="ForgotPassword" asp-controller="Account">ForgotPassword</a>
						<button type="submit" class="btn btn-default">Login</button>	
					</form>
					
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->
