@model AppUserModel
@{
    ViewData["Title"] = "New Password";
}

<section>
    <div class="container">
        <div class="row">
            <div class="col-sm-8 col-sm-offset-1">
                <div class="login-form">
                    <h2>New Password</h2>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <form asp-action="UpdateNewPassword" asp-controller="Account" method="post">

                        <!-- Email (readonly) -->
                        <input asp-for="Email" placeholder="Email" value="@ViewBag.Email" readonly />
                        <span asp-validation-for="Email" class="text-danger"></span>

                        <!-- Token ẨN -->
                        <input type="hidden"
                               name="token"
                               value="@ViewBag.Token" />

                        <!-- New Password -->
                        <input type="password" asp-for="PasswordHash" placeholder="Password" />
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>

                        <button type="submit" class="btn btn-default">
                            Change Password
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
