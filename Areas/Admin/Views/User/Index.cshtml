@{
    ViewData["Title"] = "User Management";
}
<h3>User Management</h3>
<a class="btn btn-success btn-sm" asp-action="Create" asp-controller="User">Add User</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">User Name</th>
            <th scope="col">Email</th>
            <th scope="col">Phone</th>
            <th scope="col">Role</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var users in Model)
        {
            <tr>
                <th scope="row">@users.User.Id</th>
                <td>@users.User.UserName</td>
                <td>@users.User.Email</td>
                <td>@users.User.PhoneNumber</td>
                <td>
                    @users.RoleName
                </td>
                <td>
                   @if(users.User.Id != ViewBag.loggedInUserId)
                   {
                        @if(users.RoleName != "Admin")
                        {
                            <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="User" asp-route-id="@users.User.Id">Edit</a>
                            <a class="btn btn-danger btn-sm" asp-action="Delete" asp-controller="User" asp-route-id="@users.User.Id" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

