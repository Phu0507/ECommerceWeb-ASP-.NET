@model IEnumerable<OrderDetails>
@{
    ViewData["Title"] = "OrderDetails Management";
    decimal total = 0;
    decimal subtotal = 0;
}
<h3>List OrderDetails</h3>
<table class="table" id="detailOrder">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Order Code</th>
            <th scope="col">UserName</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        <input type="hidden" id="orderCode" value="@Model.First().OrderCode" />
        @foreach (var item in Model)
        {
            subtotal = item.Price * item.Quantity;
            total += subtotal;
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.OrderCode</td>
                <td>@item.Username</td>
                <td>@item.Product.Name</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@subtotal.ToString("#,##0 VND")</td>
            </tr>
        }
        <tr>
            <th colspan="6">Shipping Cost:</th>
            <td colspan="2">@ViewBag.ShippingCost.ToString("#,##0 VND")</td>
        </tr>
        <tr>
            <th colspan="6">Total:</th>
            <td colspan="2">
                @((total + (decimal)(ViewBag.ShippingCost ?? 0)).ToString("#,##0 VND"))
            </td>

            <td>
                @if (@ViewBag.Status != 3)
                {
                    <select class="form-control select-update-order">
                        <option value="1">Đơn hàng mới</option>
                        <option value="2">Đang xử lý</option>
                        <option value="3">Hủy</option>
                    </select>
                }
            </td>
        </tr>
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select-update-order').change(function () {
                var status = $(this).val();
                var orderCode = $('#orderCode').val();
                $.ajax({
                    url: '@Url.Action("UpdateOrder")',
                    type: 'POST',
                    data: {
                        orderCode: orderCode,
                        status: status
                    },
                    success: function (response) {
                        Swal.fire("Order status updated successfully!");
                    },
                    error: function (xhr, status, error) {
                        Swal.fire("Error updating order status: " + error);
                    }
                });
            });
        });
    </script>
}

