@model IEnumerable<ProductModel>
@{
    ViewData["Title"] = "Product Management";
}
<h3>Product Management</h3>
<a class="btn btn-success btn-sm" asp-action="Create" asp-controller="Product">Add Product</a>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Product Name</th>
            <th scope="col">Quantity</th>
            <th scope="col">Slod</th>
            <th scope="col">Description</th>
            <th scope="col">Price</th>
            <th scope="col">Slug</th>
            <th scope="col">Category</th>
            <th scope="col">Brand</th>
            <th scope="col">Image</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td class="text-center">
                    <span class="badge bg-primary fs-6 px-3 py-2 d-inline-block mb-1">
                        @item.Quantity
                    </span>
                    <br />
                    <a asp-action="AddQuantity"
                       asp-controller="Product"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-success">
                        <i class="bi bi-plus-circle"></i> Add Quantity
                    </a>
                </td>


                <td>@item.Sold</td>
                <td>@Html.Raw(@item.Description)</td>
                <td>@item.Price</td>
                <td>@item.Slug</td>
                <td>@item.Category.Name</td>
                <td>@item.Brand.Name</td>
                <td><img width="120" src="~/media/products/@item.ImageUrl" alt="@item.Name" /></td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Product" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-controller="Product" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    
}

