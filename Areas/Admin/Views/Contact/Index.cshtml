@model IEnumerable<ContactModel>
@{
    ViewData["Title"] = "Contact Management";
}
<h3>Contact Management</h3>
@*@<a class="btn btn-success btn-sm" asp-action="Create" asp-controller="Contact">Add Contact</a>*@
<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Contact Name</th>
            <th scope="col">Description</th>
            <th scope="col">Map</th>
            <th scope="col">SDT</th>
            <th scope="col">Email</th>
            <th scope="col">Image</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@Html.Raw(@item.Description)</td>
                <td>@Html.Raw(@item.Map)</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td><img width="120" src="~/media/logo/@item.LogoImg" alt="@item.Name" /></td>

                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Contact" asp-route-name="@item.Name">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-controller="Contact" asp-route-name="@item.Name" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

